# Application Configuration
NODE_ENV=development
PORT=4000

# Test Harness Authentication (strictly non-production, requires NODE_ENV=development)
ALLOW_TEST_HARNESS_AUTH=true

# Institutional OTP Email Delivery Configuration
# Transport options: 'smtp' | 'inmemory' | 'auto' (default: auto -> smtp if SMTP_HOST provided, else inmemory with warning in development)
EMAIL_TRANSPORT=auto
# If set to true, requests fail if real delivery cannot be performed (strictly required in production)
EMAIL_DELIVERY_REQUIRED=false
# Outgoing sender identity
EMAIL_FROM="Campus Duo IITK <noreply@campusduo.iitk.ac.in>"

# SMTP Provider Settings (e.g., IITK mail relay or external provider like SendGrid, AWS SES, Mailgun, etc.)
SMTP_HOST=smtp.iitk.ac.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# PostgreSQL Connection Settings for campus_duo_app
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=campus_duo_dev
PGUSER=campus_duo_app
PGPASSWORD=cs455

# Optional Database URL override:
# DATABASE_URL=postgresql://campus_duo_app:cs455@127.0.0.1:5432/campus_duo_dev

# Hugging Face hosted inference (KAN-45)
ENABLE_LLM_INFERENCE=false
HF_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
HF_TIMEOUT_MS=20000
# HF_TOKEN=
