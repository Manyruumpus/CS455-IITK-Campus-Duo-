# Frontend API origin. Keep this pointed at the backend in local development.
VITE_API_URL=http://localhost:4000

# Use the real HTTP/PostgreSQL workflow. Leave false for a mock-only UI demo.
VITE_USE_LIVE_BOOKING=true
VITE_USE_LIVE_PROFILE=true

# Development-only role switching. Never enable this for a production build.
VITE_DEMO_MODE=false
VITE_DEMO_SHOWCASE=false

# Optional presentation-only features.
VITE_ENABLE_MESSAGING=false
VITE_ENABLE_PREVIEW=false
